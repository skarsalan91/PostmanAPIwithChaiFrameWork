    {
      "name": "DataVerification",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsondata = pm.response.json();\r",
              "pm.test(\"Datatype verification for the response\"), () =>\r",
              "{\r",
              "    pm.expect(jsondata).to.be.an(\"object\");\r",
              "    pm.expect(jsondata.users).to.be.an(\"array\");\r",
              "    pm.expect(jsondata.users[0].id).to.be.a(\"number\");\r",
              "    pm.expect(jsondata.users[0].firstName).to.be.an(\"string\");\r",
              "}\r",
              "\r",
              "pm.test(\"Data verification for the response\"), () =>\r",
              "{\r",
              "   pm.expect(jsondata.users[0].id).to.be.eql(1);\r",
              "   pm.expect(jsondata.users[0].lastName).to.be.eql(\"Johnson\");\r",
              "   pm.expect(jsondata.users[0].maidenName).to.be.eql(\"Smith\");\r",
              "   pm.expect(jsondata.users[0].hair.color).to.be.eql(\"Brown\");\r",
              "\r",
              "\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
